{
  "$comment": "team-up user config. Copied to ~/.team-up/roster.json by 'team-up init'. Curate models/roles/chains yourself — team-up ships no live model list. cmd templates are argv arrays; {model}, {prompt}, and {effort} are substituted literally per element. Chain entries may be bare model ids (uses models[m].cli[0]) or CLI×model pins ('cursor:grok-4.5-high' / {\"cli\":\"hermes\",\"model\":\"deepseek-v4-pro\"}). Specialist-eligible models (those with tier) must declare account + abstract reasoning maps. Command-broker / shell-denial support comes from installed team-up harness adapters plus ~/.team-up/harness-verification records — never from roster booleans.",
  "schema_version": 2,
  "accounts": {
    "claude": { "kind": "subscription", "enabled": true },
    "codex": { "kind": "subscription", "enabled": true },
    "cursor": { "kind": "subscription", "enabled": true },
    "api": { "kind": "credit", "enabled": true, "remaining": 100 }
  },
  "clis": {
    "claude": {
      "$comment": "Do not use --dangerously-skip-permissions — the Claude harness adapter refuses it and denies Bash while exposing only the team-up command broker MCP tools.",
      "cmd": ["claude", "--model", "{model}", "--effort", "{effort}", "{prompt}"]
    },
    "codex": {
      "cmd": ["codex", "--dangerously-bypass-approvals-and-sandbox", "--model", "{model}", "-c", "model_reasoning_effort={effort}", "{prompt}"]
    },
    "cursor": {
      "$comment": "Home-installed cursor-agent needs non-empty sandbox.runtime_paths (wrapper + node runtime). Omit until you list real paths — empty [] is treated as not configured.",
      "cmd": ["cursor-agent", "--yolo", "--model", "{model}", "{prompt}"]
    },
    "opencode": {
      "cmd": ["opencode", "--model", "{model}", "--prompt", "{prompt}"]
    },
    "hermes": {
      "cmd": ["hermes", "chat", "-q", "{prompt}", "--model", "{model}"]
    }
  },
  "subscriptions": ["claude", "codex", "cursor"],
  "usage_watcher": {
    "tick_sec": 60,
    "intervals": { "idle_heartbeat_hours": 24, "active_min": 20, "busy_min": 8 }
  },
  "models": {
    "claude-fable-5": {
      "provider": "anthropic",
      "tier": "frontier",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h", "claude:fable-week"],
      "priority": 1,
      "price": { "in": null, "out": null, "note": "fill in per effort level" },
      "strengths": ["architecture", "review"],
      "weaknesses": ["cost"]
    },
    "claude-opus": {
      "provider": "anthropic",
      "tier": "high",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h"],
      "priority": 2
    },
    "claude-sonnet-5": {
      "provider": "anthropic",
      "tier": "medium",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h"],
      "priority": 2
    },
    "claude-haiku": {
      "provider": "anthropic",
      "tier": "low",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h"],
      "priority": 3
    },
    "gpt-5.6-sol": {
      "provider": "openai",
      "tier": "frontier",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly"],
      "priority": 2
    },
    "gpt-5.6-terra": {
      "provider": "openai",
      "tier": "high",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly"],
      "priority": 3
    },
    "gpt-5.6-luna": {
      "provider": "openai",
      "tier": "medium",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly"],
      "priority": 3
    },
    "gpt-5.4-mini": {
      "provider": "openai",
      "tier": "low",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly"],
      "priority": 4
    },
    "composer-2.5": {
      "provider": "cursor",
      "tier": "medium",
      "cli": ["cursor"],
      "account": "cursor",
      "reasoning": { "max": "high", "high": "high", "medium": null, "low": null },
      "limit_windows": ["cursor:included"],
      "priority": 1
    },
    "grok-4.5-high": {
      "provider": "xai",
      "tier": "high",
      "cli": ["cursor", "opencode", "hermes"],
      "account": "cursor",
      "reasoning": { "max": "high", "high": "high", "medium": null, "low": null },
      "priority": 4
    },
    "deepseek-v4-pro": {
      "provider": "deepseek",
      "tier": "medium",
      "cli": ["hermes", "opencode"],
      "account": "api",
      "reasoning": { "max": "high", "high": "high", "medium": "medium", "low": "low" },
      "priority": 5
    },
    "deepseek-v4-flash": {
      "provider": "deepseek",
      "tier": "low",
      "cli": ["hermes", "opencode"],
      "account": "api",
      "reasoning": { "max": "high", "high": "high", "medium": "medium", "low": "low" },
      "priority": 5
    }
  },
  "roles": {
    "planner": {
      "chain": [
        "claude:claude-opus",
        "codex:gpt-5.6-sol",
        "claude:claude-sonnet-5",
        "codex:gpt-5.6-terra"
      ]
    },
    "reviewer": {
      "chain": [
        "claude:claude-opus",
        "claude:claude-sonnet-5",
        "codex:gpt-5.6-terra"
      ]
    },
    "advisor": {
      "chain": [
        "claude:claude-fable-5",
        "claude:claude-opus"
      ]
    },
    "implementer": {
      "chain": [
        "cursor:composer-2.5",
        "cursor:grok-4.5-high",
        "codex:gpt-5.6-luna",
        "claude:claude-sonnet-5",
        "hermes:deepseek-v4-pro"
      ]
    },
    "researcher": {
      "chain": [
        "codex:gpt-5.6-luna",
        "claude:claude-sonnet-5",
        "hermes:deepseek-v4-pro"
      ]
    },
    "prompt-writer": {
      "chain": ["claude:claude-sonnet-5", "codex:gpt-5.6-luna"]
    },
    "frontend-designer": {
      "chain": [
        "cursor:composer-2.5",
        "cursor:grok-4.5-high",
        "claude:claude-sonnet-5",
        "codex:gpt-5.6-luna"
      ]
    },
    "scout": {
      "chain": [
        "claude:claude-haiku",
        "hermes:deepseek-v4-flash",
        "codex:gpt-5.4-mini"
      ]
    },
    "summarizer": {
      "chain": [
        "hermes:deepseek-v4-flash",
        "claude:claude-haiku",
        "codex:gpt-5.4-mini"
      ]
    },
    "test-writer": {
      "chain": [
        "claude:claude-sonnet-5",
        "cursor:composer-2.5",
        "codex:gpt-5.6-luna"
      ]
    },
    "observer": {
      "chain": [
        "cursor:grok-4.5-high",
        "codex:gpt-5.4-mini"
      ]
    }
  },
  "limits": { "warn_at": 0.9, "handoff_at": 0.95, "handoff_at_burst": 0.8 }
}
