{
  "$comment": "team-up user config. Copied to ~/.team-up/roster.json by 'team-up init'. Curate models/roles/chains yourself — team-up ships no live model list. cmd templates are argv arrays; {model}, {prompt}, and {effort} are substituted literally per element. Chain entries may be bare model ids (uses models[m].cli[0]) or CLI×model pins ('cursor:grok-4.5-high' / {\"cli\":\"hermes\",\"model\":\"deepseek-v4-pro\"}). Specialists run on a role's chain ({\"role\": \"implementer\"}) or a chain of their own ({\"chain\": [...]}) under specialists; an unassigned specialist does not launch. Command-broker / shell-denial support comes from installed team-up harness adapters plus ~/.team-up/harness-verification records — never from roster booleans.",
  "schema_version": 2,
  "accounts": {
    "claude": { "kind": "subscription", "enabled": true },
    "codex": { "kind": "subscription", "enabled": true },
    "cursor": { "kind": "subscription", "enabled": true },
    "api": { "kind": "credit", "enabled": true, "remaining": 100 }
  },
  "clis": {
    "claude": {
      "$comment": "--dangerously-skip-permissions is required: a dispatched worker runs in detached tmux with nobody to answer a permission prompt, so without it the run never reaches done. Specialist launches strip the flag themselves and pin a tool allowlist plus the command broker instead.",
      "cmd": ["claude", "--dangerously-skip-permissions", "--model", "{model}", "--effort", "{effort}", "{prompt}"]
    },
    "codex": {
      "cmd": ["codex", "--dangerously-bypass-approvals-and-sandbox", "--model", "{model}", "-c", "model_reasoning_effort={effort}", "{prompt}"]
    },
    "cursor": {
      "$comment": "Home-installed cursor-agent needs non-empty sandbox.runtime_paths (wrapper + node runtime). Omit until you list real paths — empty [] is treated as not configured.",
      "cmd": ["cursor-agent", "--yolo", "--model", "{model}", "{prompt}"]
    },
    "opencode": {
      "cmd": ["opencode", "--model", "{model}", "--prompt", "{prompt}"]
    },
    "hermes": {
      "cmd": ["hermes", "chat", "-q", "{prompt}", "--model", "{model}"]
    }
  },
  "subscriptions": ["claude", "codex", "cursor"],
  "usage_watcher": {
    "tick_sec": 60,
    "intervals": { "idle_heartbeat_hours": 24, "idle_min": 30, "active_min": 20, "busy_min": 8 }
  },
  "models": {
    "claude-opus": {
      "provider": "anthropic",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h"],
      "priority": 2
    },
    "claude-sonnet-5": {
      "provider": "anthropic",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h"],
      "priority": 2
    },
    "claude-haiku": {
      "provider": "anthropic",
      "cli": ["claude"],
      "account": "claude",
      "reasoning": { "max": "max", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["claude:session", "claude:week", "claude:5h"],
      "priority": 3
    },
    "gpt-5.6-sol": {
      "provider": "openai",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly", "codex:5h"],
      "priority": 2
    },
    "gpt-5.6-terra": {
      "provider": "openai",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly", "codex:5h"],
      "priority": 3
    },
    "gpt-5.6-luna": {
      "provider": "openai",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly", "codex:5h"],
      "priority": 3
    },
    "gpt-5.4-mini": {
      "provider": "openai",
      "cli": ["codex"],
      "account": "codex",
      "reasoning": { "max": "xhigh", "high": "high", "medium": "medium", "low": "low" },
      "limit_windows": ["codex:weekly", "codex:5h"],
      "priority": 4
    },
    "composer-2.5": {
      "provider": "cursor",
      "cli": ["cursor"],
      "account": "cursor",
      "reasoning": { "max": "high", "high": "high", "medium": null, "low": null },
      "limit_windows": ["cursor:included"],
      "priority": 1
    },
    "grok-4.5-high": {
      "provider": "xai",
      "cli": ["cursor", "opencode", "hermes"],
      "cli_model": { "cursor": "cursor-grok-4.5-high", "opencode": "openrouter/x-ai/grok-4.5" },
      "account": "cursor",
      "reasoning": { "max": "high", "high": "high", "medium": null, "low": null },
      "priority": 4
    },
    "deepseek-v4-pro": {
      "provider": "deepseek",
      "cli": ["hermes"],
      "account": "api",
      "reasoning": { "max": "high", "high": "high", "medium": "medium", "low": "low" },
      "priority": 5
    },
    "deepseek-v4-flash": {
      "provider": "deepseek",
      "cli": ["hermes"],
      "account": "api",
      "reasoning": { "max": "high", "high": "high", "medium": "medium", "low": "low" },
      "priority": 5
    }
  },
  "roles": {
    "planner": {
      "chain": [
        "claude:claude-opus",
        "codex:gpt-5.6-sol",
        "claude:claude-sonnet-5",
        "codex:gpt-5.6-terra"
      ]
    },
    "reviewer": {
      "chain": [
        "claude:claude-opus",
        "claude:claude-sonnet-5",
        "codex:gpt-5.6-terra"
      ]
    },
    "advisor": {
      "chain": [
        "claude:claude-opus"
      ]
    },
    "implementer": {
      "chain": [
        "cursor:composer-2.5",
        "cursor:grok-4.5-high",
        "codex:gpt-5.6-luna",
        "claude:claude-sonnet-5",
        "hermes:deepseek-v4-pro"
      ]
    },
    "researcher": {
      "chain": [
        "codex:gpt-5.6-luna",
        "claude:claude-sonnet-5",
        "hermes:deepseek-v4-pro"
      ]
    },
    "prompt-writer": {
      "chain": ["claude:claude-sonnet-5", "codex:gpt-5.6-luna"]
    },
    "frontend-designer": {
      "chain": [
        "cursor:composer-2.5",
        "cursor:grok-4.5-high",
        "claude:claude-sonnet-5",
        "codex:gpt-5.6-luna"
      ]
    },
    "scout": {
      "chain": [
        "claude:claude-haiku",
        "hermes:deepseek-v4-flash",
        "codex:gpt-5.4-mini"
      ]
    },
    "summarizer": {
      "chain": [
        "hermes:deepseek-v4-flash",
        "claude:claude-haiku",
        "codex:gpt-5.4-mini"
      ]
    },
    "test-writer": {
      "chain": [
        "claude:claude-sonnet-5",
        "cursor:composer-2.5",
        "codex:gpt-5.6-luna"
      ]
    },
    "observer": {
      "chain": [
        "cursor:grok-4.5-high",
        "codex:gpt-5.4-mini"
      ]
    }
  },
  "limits": { "warn_at": 0.9, "handoff_at": 0.95, "handoff_at_burst": 0.8, "project_min": 30 },
  "admission": {
    "$comment": "Gate on every worker start (dispatch, specialist run, runs resume). max_workers null derives the limit from telemetry (team-up telemetry install-timer); until telemetry has enough samples every start is capped at fallback_max_workers. Set max_workers to a number to fix the limit yourself. All keys: docs/configuration.md#admission.",
    "max_workers": null,
    "fallback_max_workers": 2
  },
  "openrouter": {
    "$comment": "OpenRouter key for model scans and benchmarks: env OPENROUTER_API_KEY, then ~/.team-up/secrets.env, then this 0600 KEY=VALUE file.",
    "key_file": "~/.config/openrouter.env"
  },
  "specialists": {
    "coding.codey": { "role": "implementer" },
    "research.reanna": { "role": "researcher" },
    "review.revan": { "role": "reviewer" },
    "testing.tessa": { "role": "test-writer" }
  }
}
